# ── Server ───────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database (Prisma + PostgreSQL) ────────────────────
# Local: postgresql://USER:PASSWORD@localhost:5432/finflow
# Supabase / Neon / Railway: get connection string from their dashboard
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/finflow?schema=public"

# ── JWT ───────────────────────────────────────────────
# Generate a strong secret:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_your_long_random_secret_min_32_chars
JWT_EXPIRE=7d

# ── Google Gemini AI ──────────────────────────────────
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Cloudinary (for receipt image CDN) ───────────────
# Get credentials at: https://cloudinary.com
# Note: receipts are processed in-memory — Cloudinary is optional
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
